# Discord
DISCORD_TOKEN=your_token_here
DISCORD_OWNER_ID=0
DISCORD_DEV_GUILD_ID=951100426399395900

# Lavalink
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

# YouTube
# Refresh token of a spare Google account. Leave empty on first run, then copy it
# from the Lavalink logs after completing the google.com/device sign-in.
YOUTUBE_OAUTH_REFRESH_TOKEN=
# Optional shared secret between Lavalink and the yt-cipher container.
YOUTUBE_CIPHER_PASSWORD=

# Locale (en/vi)
LOCALE=en

# Modmail
# Comma-separated list of guild IDs allowed to use modmail (supports multiple servers).
# MODMAIL_GUILD_ID (single value) is still accepted as a legacy fallback.
MODMAIL_GUILD_IDS=your_guild_id_1,your_guild_id_2
MODMAIL_CATEGORY_ID=0
